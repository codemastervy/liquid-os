#!/bin/sh
set -e

# live-build's ubuntu-mode syslinux stage (scripts/build/lb_binary_syslinux)
# has two hardcoded legacy assumptions that no longer hold on modern Ubuntu:
#
# 1. It unconditionally does
#      tar xfz /usr/share/gfxboot-theme-ubuntu/bootlogo.tar.gz -C <target>
#    for LB_MODE=ubuntu, regardless of --syslinux-theme. The
#    gfxboot-theme-ubuntu package itself no longer exists in Ubuntu's
#    archive at all, so nothing installs that file. Ubuntu's own patch to
#    this script (not present in upstream Debian live-build -- confirmed by
#    diffing the actual installed .deb) ALSO unconditionally does
#      (cd "$tmpdir" && cpio -i) < ${_TARGET}/bootlogo
#    later on regardless of theme/mode, expecting a real cpio archive named
#    "bootlogo" to have come out of that tarball. An empty tar.gz alone
#    isn't enough -- ship a tarball containing a valid (if empty) cpio
#    archive named "bootlogo" so both steps are harmless no-ops.
#
# 2. With --syslinux-theme live-build, it renders a splash via
#      rsvg --format png --height 480 --width 640 splash.svg splash.png
#    but librsvg2-bin has shipped only `rsvg-convert` (different flag
#    style: -o/--output instead of a second positional argument) for years.
#    Provide a small wrapper at /usr/bin/rsvg that translates the old
#    invocation into the rsvg-convert equivalent.
#
# 3. The live-build-bundled isolinux template (share/bootloaders/isolinux/)
#    contains two symlinks pointing at a pre-reorg syslinux layout:
#    isolinux.bin -> /usr/lib/syslinux/isolinux.bin (isolinux.bin has since
#    moved into its own `isolinux` package at /usr/lib/ISOLINUX/isolinux.bin)
#    and vesamenu.c32 -> /usr/lib/syslinux/vesamenu.c32 (syslinux-common now
#    nests its modules under modules/bios/). Both are dangling on modern
#    Ubuntu, so lb_binary_syslinux's `cp -aL` dereferencing copy fails with
#    "cannot stat". Recreate the old flat paths as compatibility symlinks.

echo "[liquidos] Installing syslinux flat-layout compatibility symlinks"
mkdir -p /usr/lib/syslinux
ln -sf /usr/lib/ISOLINUX/isolinux.bin /usr/lib/syslinux/isolinux.bin
ln -sf /usr/lib/syslinux/modules/bios/vesamenu.c32 /usr/lib/syslinux/vesamenu.c32

echo "[liquidos] Installing legacy gfxboot-theme-ubuntu placeholder"
mkdir -p /usr/share/gfxboot-theme-ubuntu
BOOTLOGO_TMP=$(mktemp -d)
: | cpio -o --quiet --format=newc > "$BOOTLOGO_TMP/bootlogo"
tar czf /usr/share/gfxboot-theme-ubuntu/bootlogo.tar.gz -C "$BOOTLOGO_TMP" bootlogo
rm -rf "$BOOTLOGO_TMP"

echo "[liquidos] Installing rsvg -> rsvg-convert compatibility wrapper"
cat > /usr/bin/rsvg <<'EOF'
#!/bin/sh
set -e
fmt=""
height=""
width=""
files=""
while [ $# -gt 0 ]; do
  case "$1" in
    --format) fmt="$2"; shift 2 ;;
    --height) height="$2"; shift 2 ;;
    --width) width="$2"; shift 2 ;;
    *) files="$files $1"; shift ;;
  esac
done
set -- $files
input="$1"
output="$2"
exec rsvg-convert ${fmt:+--format "$fmt"} ${height:+--height "$height"} ${width:+--width "$width"} --output "$output" "$input"
EOF
chmod +x /usr/bin/rsvg
