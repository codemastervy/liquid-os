#!/bin/sh
set -e

echo "[liquidos] Building Yaru-Liquid theme variants"

for variant in Yaru Yaru-dark; do
  src="/usr/share/themes/${variant}"
  case "$variant" in
    Yaru) dst="/usr/share/themes/Yaru-Liquid" ;;
    Yaru-dark) dst="/usr/share/themes/Yaru-Liquid-dark" ;;
  esac

  if [ ! -d "$src" ]; then
    echo "[liquidos] WARNING: $src not found, skipping"
    continue
  fi

  cp -a "$src" "$dst"

  for gtkver in gtk-3.0 gtk-4.0; do
    css="$dst/$gtkver/gtk.css"
    [ -f "$css" ] || continue
    cat >> "$css" <<'EOF'

/* --- Liquid Glass overrides (Liquid OS) --- */
window.background,
.titlebar,
headerbar,
popover,
.popover,
.view {
  background-color: rgba(30, 30, 42, 0.62);
}

headerbar, .titlebar {
  background-color: rgba(40, 40, 56, 0.5);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

window.background {
  border-radius: 14px;
}

button {
  background-color: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 10px;
}

button:hover {
  background-color: rgba(255, 255, 255, 0.12);
}

.sidebar-pane, list {
  background-color: rgba(24, 24, 34, 0.5);
}
EOF
  done
done

echo "[liquidos] Theme variants written"
