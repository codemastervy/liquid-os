[org/gnome/desktop/interface]
gtk-theme='Yaru-Liquid-dark'
icon-theme='Yaru'
color-scheme='prefer-dark'
cursor-theme='Yaru'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/liquidos/wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/liquidos/wallpaper.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/liquidos/wallpaper.png'

[org/gnome/shell]
enabled-extensions=['blur-my-shell@aunetx']
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'firefox_firefox.desktop', 'ubiquity.desktop']

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
brightness=0.65
sigma=30

[org/gnome/shell/extensions/blur-my-shell/overview]
blur=true
pipeline='pipeline_default_rounded'

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=true

[org/gnome/shell/extensions/blur-my-shell/appfolder]
blur=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
